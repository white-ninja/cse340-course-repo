<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= project.title %></h2>
    <p>Description: <%= project.description %></p>
    <p>Date: <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
    <p>Location: <%= project.location %></p>
    <p>
        Partner Organization:
        <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
    </p>
    <p>
        Categories:
        <% if (categories && categories.length > 0) { %>
            <span class="category-tags" aria-label="Project categories">
                <% categories.forEach(category => { %>
                    <a class="category-tag" href="/category/<%= category.category_id %>"><%= category.name %></a>
                <% }); %>
            </span>
        <% } else { %>
            <span>No categories assigned.</span>
        <% } %>
    </p>
</main>
<%- include('partials/footer') %>

<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <% if (users && users.length > 0) { %>
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(userRecord => { %>
                    <tr>
                        <td><%= userRecord.name %></td>
                        <td><%= userRecord.email %></td>
                        <td><%= userRecord.role_name %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    <% } else { %>
        <p>No registered users found.</p>
    <% } %>
</main>
<%- include('partials/footer') %>

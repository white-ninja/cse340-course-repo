<%- include('partials/header') %>
<main class="form-page">
    <h1><%= projectDetails.title %></h1>
    <h2>Assign Categories</h2>

    <form
        class="organization-form"
        action="/assign-categories/<%= projectId %>"
        method="POST"
    >
        <fieldset class="form-group category-checkboxes">
            <legend>Categories</legend>
            <% categories.forEach(category => { %>
                <label for="category-<%= category.category_id %>">
                    <input
                        type="checkbox"
                        id="category-<%= category.category_id %>"
                        name="categoryIds"
                        value="<%= category.category_id %>"
                        <%= assignedCategories.some(assigned => assigned.category_id === category.category_id) ? 'checked' : '' %>
                    />
                    <%= category.name %>
                </label>
            <% }); %>
        </fieldset>

        <button type="submit">Update Categories</button>
    </form>
</main>
<%- include('partials/footer') %>

<%- include('partials/header') %>
<%
    const dateValue = project.date instanceof Date
        ? project.date.toISOString().slice(0, 10)
        : String(project.date).slice(0, 10);
%>
<main class="form-page">
    <h1><%= title %></h1>

    <form
        class="organization-form"
        action="/edit-project/<%= project.project_id %>"
        method="POST"
    >
        <div class="form-group">
            <label for="title">Project Title</label>
            <input
                type="text"
                id="title"
                name="title"
                value="<%= project.title %>"
                maxlength="200"
                required
            />
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                maxlength="1000"
                rows="5"
                required
            ><%= project.description %></textarea>
        </div>

        <div class="form-group">
            <label for="location">Location</label>
            <input
                type="text"
                id="location"
                name="location"
                value="<%= project.location %>"
                maxlength="200"
                required
            />
        </div>

        <div class="form-group">
            <label for="date">Date</label>
            <input
                type="date"
                id="date"
                name="date"
                value="<%= dateValue %>"
                required
            />
        </div>

        <div class="form-group">
            <label for="organizationId">Organization</label>
            <select
                id="organizationId"
                name="organizationId"
                required
            >
                <% organizations.forEach(org => { %>
                    <option
                        value="<%= org.organization_id %>"
                        <%= String(org.organization_id) === String(project.organization_id) ? 'selected' : '' %>
                    >
                        <%= org.name %>
                    </option>
                <% }); %>
            </select>
        </div>

        <button type="submit">Update Service Project</button>
    </form>
</main>
<%- include('partials/footer') %>
